#pragma once

// XON_LUA engine extension (Insanotic engine only; check before calling)
float lua_load(string vfs_path) = #680; // plugins/<name>/init.lua
float lua_hook(string hook_name, ...) = #681;
float lua_hookcount(string hook_name) = #682;

bool autocvar_g_lua;

const int LUA_MAX_PLUGINS = 64;

/** scans plugins/<name>/init.lua and loads each plugin, ordered by the "order" key
 *  of an optional plugins/<name>/plugin.json (default 0), then by folder name.
 *  The engine also calls this (by name) from the sv_lua_reload command. */
void Lua_ReloadPlugins();
